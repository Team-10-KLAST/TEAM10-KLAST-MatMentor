# Template for your local .env file.
# Copy this file to .env and fill in the values. .env is on gitignore, so it is never committed.

# Password for the local SQL Server container (sa user).
# SQL Server requires at least 8 characters from 3 of these 4 groups:
# uppercase letters, lowercase letters, digits, symbols.
# Avoid ; $ ' " # ! and spaces - they break the connection string or the shell.
MSSQL_SA_PASSWORD=

# Signing key for the API's login tokens (JWT).
# Must be at least 32 characters - HMAC-SHA256 needs a 256-bit key.
# Generate one in PowerShell:
#   "$([guid]::NewGuid().ToString('N'))$([guid]::NewGuid().ToString('N'))"
# You can use the same value as in your user-secrets.
JWT_SECRET_KEY=