  "components": {
    "schemas": {
      "CreateStudentProfileRequest": {
        "required": [
          "username",
          "password",
          "parentEmail",
          "grade",
          "interestIds"
        ],
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "parentEmail": {
            "type": "string"
          },
          "grade": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "interestIds": {
            "type": "array",
            "items": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        }
      },
      "CreateTutorConversationRequest": {
        "required": [
          "exerciseText",
          "attemptText",
          "requestId"
        ],
        "type": "object",
        "properties": {
          "exerciseText": {
            "type": [
              "null",
              "string"
            ]
          },
          "attemptText": {
            "type": [
              "null",
              "string"
            ]
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "ErrorResponse": {
        "required": [
          "error"
        ],
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "ExerciseItem": {
        "required": [
          "id",
          "position",
          "exerciseText",
          "unit"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "position": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "exerciseText": {
            "type": "string"
          },
          "unit": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "GetTopicsResponse": {
        "required": [
          "topics"
        ],
        "type": "object",
        "properties": {
          "topics": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TopicItem"
            }
          }
        }
      },
      "LoginRequest": {
        "required": [
          "username",
          "password"
        ],
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "LoginResponse": {
        "required": [
          "token"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          }
        }
      },
      "SendTutorMessageRequest": {
        "required": [
          "content",
          "expectedVersion",
          "messageId"
        ],
        "type": "object",
        "properties": {
          "content": {
            "type": [
              "null",
              "string"
            ]
          },
          "expectedVersion": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "messageId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "StartExerciseSetRequest": {
        "required": [
          "topicId"
        ],
        "type": "object",
        "properties": {
          "topicId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "StartExerciseSetResponse": {
        "required": [
          "attemptId",
          "exerciseSetId",
          "title",
          "exercises"
        ],
        "type": "object",
        "properties": {
          "attemptId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "exerciseSetId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "title": {
            "type": "string"
          },
          "exercises": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExerciseItem"
            }
          }
        }
      },
      "SubmitAnswerRequest": {
        "required": [
          "exerciseId",
          "answer"
        ],
        "type": "object",
        "properties": {
          "exerciseId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "answer": {
            "type": "string"
          }
        }
      },
      "TopicItem": {
        "required": [
          "id",
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "TutorConversationMessage": {
        "required": [
          "role",
          "content"
        ],
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          },
          "content": {
            "type": "string"
          }
        }
      },
      "TutorConversationResponse": {
        "required": [
          "conversationId",
          "reply",
          "version"
        ],
        "type": "object",
        "properties": {
          "conversationId": {
            "type": "string",
            "format": "uuid"
          },
          "reply": {
            "type": "string"
          },
          "version": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "TutorConversationStateResponse": {
        "required": [
          "conversationId",
          "version",
          "messages"
        ],
        "type": "object",
        "properties": {
          "conversationId": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TutorConversationMessage"
            }
          }
        }
      },
      "ValidationErrorResponse": {
        "required": [
          "errors"
        ],
        "type": "object",
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Json Web Token"
      }
    }
  },
  "tags": [
    {
      "name": "Students"
    },
    {
      "name": "Topics"
    },
    {
      "name": "Exercise Set Attempts"
    },
    {
      "name": "Auth"
    },
    {
      "name": "Tutor Conversations"
    }
